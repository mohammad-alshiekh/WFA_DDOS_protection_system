{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "dashboard",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev",
      "installCommand": "npm install",
      "bindings": [
        { "type": "service", "service": "waf", "format": "url", "env": "WAF_URL" },
        { "type": "service", "service": "target", "format": "url", "env": "TARGET_URL" }
      ]
    },
    "waf": {
      "root": "waf",
      "framework": "nestjs",
      "buildCommand": "npm run build",
      "devCommand": "npm run start:dev",
      "installCommand": "npm install",
      "bindings": [
        { "type": "service", "service": "target", "format": "url", "env": "TARGET_URL" }
      ]
    },
    "target": {
      "root": "target",
      "framework": "nestjs",
      "buildCommand": "npm run build",
      "devCommand": "npm run start:dev",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/prometheus/(.*)",
      "destination": "https://your-prometheus-host/api/v1/$1"
    },
    {
      "source": "/api/waf/(.*)",
      "destination": {
        "service": "waf"
      }
    },
    {
      "source": "/api/target/(.*)",
      "destination": {
        "service": "target"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ],
  "crons": []
}